<!-- File: MainWindow.xaml  Module: UI (Shell)  Author: IndustrialDAQ Team -->
<Window x:Class="IndustrialDAQ.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="IndustrialDAQ — 工业数据采集监控"
        Height="720" Width="1280"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <Style x:Key="NavRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="MainMenu"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Margin="8,0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BrushBgTertiary}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource InfoBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource MainBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/> <!-- 标题栏 -->
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══════════ 自定义标题栏 ═══════════ -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- 窗体图标与标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock Text="⚡" FontSize="14" Foreground="{DynamicResource InfoBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" 
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- 窗口控制按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="—" Width="40" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Click="BtnMinimize_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrushBgTertiary}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="☐" Width="40" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Click="BtnMaximize_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrushBgTertiary}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="✕" Width="40" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" Click="BtnClose_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ═══════════ 原主网格内容 ═══════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════ 左侧导航栏 ═══════════ -->
            <Border Grid.Column="0" Background="{DynamicResource BrushBgTertiary}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Logo 区域 -->
                    <Border Grid.Row="0" Padding="16,18"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🏢" FontSize="20" Foreground="{DynamicResource InfoBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="公司" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 导航菜单项 -->
                    <StackPanel Grid.Row="1" Margin="0,12">
                        <!-- 首页 -->
                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏠" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="首页" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- 设备详情 -->
                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     Command="{Binding NavigateCommand}" CommandParameter="ProductionMonitor">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M3,3V21H21V3H3M5,5H19V19H5V5M7,7V9H17V7H7M7,11V13H17V11H7M7,15V17H12V15H7Z" 
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                      Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="设备详情" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- 数据点详情 -->
                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     Command="{Binding NavigateCommand}" CommandParameter="DeviceDetail">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M4,3H20A2,2 0 0,1 22,5V20A2,2 0 0,1 20,22H4A2,2 0 0,1 2,20V5A2,2 0 0,1 4,3M4,5V20H20V5H4M6,7H18V9H6V7M6,11H18V13H6V11M6,15H14V17H6V15Z" 
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" 
                                      Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="数据点详情" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- 警报日志 -->
                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     Command="{Binding NavigateCommand}" CommandParameter="AlarmRecord">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔔" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="警报日志" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- 系统设置 -->
                        <RadioButton Style="{StaticResource NavRadioButtonStyle}"
                                     Command="{Binding NavigateCommand}" CommandParameter="SystemSettings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="系统设置" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    
                </Grid>
            </Border>

            <!-- ═══════════ 主内容区 ═══════════ -->
            <ContentControl Grid.Column="1"
                            prism:RegionManager.RegionName="MainRegion"/>
        </Grid>

        <!-- ═══════════ 全局状态栏 ═══════════ -->
        <Border Grid.Row="2" Padding="12,6"
                Background="{DynamicResource BrushBgTertiary}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 连接状态指示灯 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,16,0">
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                             VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                        <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="采集引擎已连接"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                        <Setter Property="Text" Value="采集引擎已断开"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- 状态消息 -->
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}"
                           FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                <!-- 当前时间 -->
                <TextBlock Grid.Column="2" FontSize="11"
                           Foreground="{DynamicResource TextDimBrush}"
                           VerticalAlignment="Center">
                    <TextBlock.Text>
                        <Binding Path="CurrentPage" StringFormat="{}当前页面: {0}"/>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>
