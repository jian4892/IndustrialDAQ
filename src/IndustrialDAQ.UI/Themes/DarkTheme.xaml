<!-- File: DarkTheme.xaml  Module: UI (Themes)  Author: IndustrialDAQ Team -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════ 基础色板 ═══════════ -->
    <Color x:Key="ColorBgPrimary">#0A0A0A</Color>
    <Color x:Key="ColorBgSecondary">#141414</Color>
    <Color x:Key="ColorBgTertiary">#1F1F1F</Color>
    <Color x:Key="ColorBgCard">#1A1A1A</Color>
    <Color x:Key="ColorBorderPrimary">#333333</Color>
    <Color x:Key="ColorBorderSecondary">#4D4D4D</Color>
    <Color x:Key="ColorTextPrimary">#FFFFFF</Color>
    <Color x:Key="ColorTextSecondary">#D4D4D4</Color>
    <Color x:Key="ColorTextMuted">#A3A3A3</Color>
    <Color x:Key="ColorTextDim">#7A7A7A</Color>

    <!-- ═══════════ 语义色 ═══════════ -->
    <Color x:Key="ColorSuccess">#00E676</Color>
    <Color x:Key="ColorSuccessBg">#00331A</Color>
    <Color x:Key="ColorWarning">#FFEA00</Color>
    <Color x:Key="ColorWarningBg">#332E00</Color>
    <Color x:Key="ColorDanger">#FF1744</Color>
    <Color x:Key="ColorDangerBg">#33050E</Color>
    <Color x:Key="ColorDangerBorder">#B71C1C</Color>
    <Color x:Key="ColorInfo">#00E5FF</Color>
    <Color x:Key="ColorInfoBg">#003339</Color>
    <Color x:Key="ColorDisconnected">#757575</Color>
    <Color x:Key="ColorAccent">#FF9100</Color>

    <!-- ═══════════ 基础画刷 ═══════════ -->
    <SolidColorBrush x:Key="MainBgBrush" Color="{StaticResource ColorBgPrimary}"/>
    <SolidColorBrush x:Key="PanelBgBrush" Color="{StaticResource ColorBgSecondary}"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource ColorBgCard}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource ColorBorderPrimary}"/>
    <SolidColorBrush x:Key="BorderSecondaryBrush" Color="{StaticResource ColorBorderSecondary}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource ColorTextMuted}"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource ColorTextDim}"/>

    <!-- ═══════════ 语义画刷 ═══════════ -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}"/>
    <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource ColorSuccessBg}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColorWarning}"/>
    <SolidColorBrush x:Key="WarningBgBrush" Color="{StaticResource ColorWarningBg}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ColorDanger}"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="{StaticResource ColorDangerBg}"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="{StaticResource ColorDangerBorder}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource ColorInfo}"/>
    <SolidColorBrush x:Key="InfoBgBrush" Color="{StaticResource ColorInfoBg}"/>
    <SolidColorBrush x:Key="DisconnectedBrush" Color="{StaticResource ColorDisconnected}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ColorAccent}"/>

    <!-- ═══════════ 向后兼容别名（旧命名） ═══════════ -->
    <SolidColorBrush x:Key="BrushBgPrimary" Color="{StaticResource ColorBgPrimary}"/>
    <SolidColorBrush x:Key="BrushBgSecondary" Color="{StaticResource ColorBgSecondary}"/>
    <SolidColorBrush x:Key="BrushBgTertiary" Color="{StaticResource ColorBgTertiary}"/>
    <SolidColorBrush x:Key="BrushBgCard" Color="{StaticResource ColorBgCard}"/>
    <SolidColorBrush x:Key="BrushBorderPrimary" Color="{StaticResource ColorBorderPrimary}"/>
    <SolidColorBrush x:Key="BrushBorderSecondary" Color="{StaticResource ColorBorderSecondary}"/>
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="{StaticResource ColorTextMuted}"/>
    <SolidColorBrush x:Key="BrushTextDim" Color="{StaticResource ColorTextDim}"/>
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}"/>
    <SolidColorBrush x:Key="BrushSuccessBg" Color="{StaticResource ColorSuccessBg}"/>
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}"/>
    <SolidColorBrush x:Key="BrushWarningBg" Color="{StaticResource ColorWarningBg}"/>
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}"/>
    <SolidColorBrush x:Key="BrushDangerBg" Color="{StaticResource ColorDangerBg}"/>
    <SolidColorBrush x:Key="BrushDangerBorder" Color="{StaticResource ColorDangerBorder}"/>
    <SolidColorBrush x:Key="BrushInfo" Color="{StaticResource ColorInfo}"/>
    <SolidColorBrush x:Key="BrushInfoBg" Color="{StaticResource ColorInfoBg}"/>
    <SolidColorBrush x:Key="BrushDisconnected" Color="{StaticResource ColorDisconnected}"/>

    <!-- ═══════════ 共用区块样式 ═══════════ -->
    <Style x:Key="PanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PanelBgBrush}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="6"/>
        <Setter Property="Padding" Value="10"/>
    </Style>

    <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BrushBgTertiary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSecondary}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Margin" Value="5"/>
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,8,0,4"/>
    </Style>

    <!-- ═══════════ 报警栏样式 ═══════════ -->
    <Style x:Key="AlarmBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>

    <!-- ═══════════ TreeView 暗黑风格 ═══════════ -->
    <Style TargetType="TreeView">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Border Name="ItemBorder" Background="Transparent"
                                BorderThickness="0" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- 展开/折叠箭头 -->
                                <ToggleButton x:Name="Expander" Grid.Column="0"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press" Width="16" Height="16"
                                              Margin="0,0,4,0"
                                              Background="Transparent" BorderThickness="0"
                                              Foreground="{DynamicResource BrushTextMuted}">
                                    <!-- <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <TextBlock Text="{Binding IsChecked, RelativeSource={RelativeSource Self},
                                                Converter={StaticResource TreeArrowConverter}}"
                                                       FontSize="10" Foreground="{StaticResource BrushTextMuted}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </ControlTemplate>
                                    </ToggleButton.Template> -->
                                </ToggleButton> 
                                <!-- 项内容 -->
                                <ContentPresenter x:Name="PART_Header" Grid.Column="1"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed" Margin="16,0,0,0"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BrushBorderSecondary}"/>
                        </Trigger>
                        <Trigger SourceName="ItemBorder" Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BrushBgTertiary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════ DataGrid 暗黑风格 ═══════════ -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BrushBorderSecondary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource BrushBgTertiary}"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSecondary}"/>
        <Setter Property="Padding" Value="6,4"/>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,2"/>
    </Style>

    <Style x:Key="DataGridRowQualityStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Quality}" Value="Bad">
                <Setter Property="Background" Value="{DynamicResource BrushDangerBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Quality}" Value="Uncertain">
                <Setter Property="Background" Value="{DynamicResource BrushWarningBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushWarning}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════ ScrollBar 暗黑 ═══════════ -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource BrushBgTertiary}"/>
    </Style>

    <!-- ═══════════ Button 暗黑风格 ═══════════ -->
    <Style x:Key="DarkButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource InfoBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource InfoBgBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
