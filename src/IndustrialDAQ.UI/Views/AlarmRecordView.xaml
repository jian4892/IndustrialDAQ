<!-- File: AlarmRecordView.xaml  Module: UI (Views)  Author: IndustrialDAQ Team -->
<UserControl x:Class="IndustrialDAQ.UI.Views.AlarmRecordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:IndustrialDAQ.UI.Views"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource MainBgBrush}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ 统计摘要栏 ═══ -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource PanelBorderStyle}" Margin="0,0,4,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="📊" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextDimBrush}"/>
                    <StackPanel>
                        <TextBlock Text="报警总数" FontSize="11"
                                   Foreground="{DynamicResource TextDimBrush}"/>
                        <TextBlock Text="{Binding TotalCount}" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{DynamicResource PanelBorderStyle}" Margin="4,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="🔴" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource DangerBrush}"/>
                    <StackPanel>
                        <TextBlock Text="活跃报警" FontSize="11"
                                   Foreground="{DynamicResource TextDimBrush}"/>
                        <TextBlock Text="{Binding ActiveCount}" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource DangerBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{DynamicResource PanelBorderStyle}" Margin="4,0,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="✅" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource SuccessBrush}"/>
                    <StackPanel>
                        <TextBlock Text="确认率" FontSize="11"
                                   Foreground="{DynamicResource TextDimBrush}"/>
                        <TextBlock FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0:P0}">
                                    <Binding Path="TotalCount"/>
                                    <Binding Path="ActiveCount"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ 筛选栏 ═══ -->
        <Border Grid.Row="1" Style="{DynamicResource PanelBorderStyle}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 级别筛选 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,16,0">
                    <TextBlock Text="报警级别:" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="100" Height="28"
                              VerticalContentAlignment="Center"
                              ItemsSource="{x:Static views:AlarmRecordView.SeverityFilterList}"
                              SelectedItem="{Binding FilterSeverity}"/>
                </StackPanel>

                <!-- 状态筛选 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,16,0">
                    <TextBlock Text="状态:" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="100" Height="28"
                              VerticalContentAlignment="Center"
                              ItemsSource="{x:Static views:AlarmRecordView.StatusFilterList}"
                              SelectedItem="{Binding FilterStatus}"/>
                </StackPanel>

                <!-- 搜索框 -->
                <TextBox Grid.Column="2" Height="28"
                         Margin="0,0,16,0" VerticalAlignment="Center"
                         CaretBrush="{DynamicResource TextPrimaryBrush}">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource BrushBgTertiary}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- 刷新按钮 -->
                <Button Grid.Column="3" Content="🔄 刷新"
                        Command="{Binding RefreshCommand}"
                        Width="70" Height="28" Margin="0,0,8,0"
                        Background="{DynamicResource InfoBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- 确认全部按钮 -->
                <Button Grid.Column="4" Content="✅ 确认全部"
                        Command="{Binding AcknowledgeAllCommand}"
                        Width="90" Height="28" Margin="0,0,8,0"
                        Background="{DynamicResource SuccessBrush}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- ═══ 报警数据表 ═══ -->
        <Border Grid.Row="2" Style="{DynamicResource PanelBorderStyle}">
            <DataGrid ItemsSource="{Binding FilteredAlarms}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      SelectionMode="Single">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Severity}" Value="严重">
                                <Setter Property="Background" Value="{DynamicResource BrushDangerBg}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="警告">
                                <Setter Property="Background" Value="{DynamicResource BrushWarningBg}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <!-- 级别指示 -->
                    <DataGridTemplateColumn Header="级别" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding SeverityColor}" CornerRadius="3"
                                        Padding="6,2" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Severity}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 报警 ID -->
                    <DataGridTextColumn Header="报警 ID" Binding="{Binding Id}" Width="70"/>

                    <!-- 来源设备 -->
                    <DataGridTextColumn Header="来源设备" Binding="{Binding Source}" Width="110"/>

                    <!-- 关联测点 -->
                    <DataGridTextColumn Header="关联测点" Binding="{Binding TagName}" Width="130"/>

                    <!-- 报警消息 -->
                    <DataGridTextColumn Header="报警消息" Binding="{Binding Message}" Width="*" MinWidth="280"/>

                    <!-- 发生时间 -->
                    <DataGridTextColumn Header="发生时间"
                                        Binding="{Binding OccurredAt, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                        Width="155"/>

                    <!-- 状态 -->
                    <DataGridTemplateColumn Header="状态" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold"
                                           Foreground="{Binding StatusColor}" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 确认按钮 -->
                    <DataGridTemplateColumn Header="操作" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="确认"
                                        Command="{Binding DataContext.AcknowledgeCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Width="56" Height="24" FontSize="11"
                                        Background="{DynamicResource InfoBrush}"
                                        Foreground="White" BorderThickness="0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="3"/>
                                        </Style>
                                    </Button.Resources>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="活跃">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="已确认">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="已清除">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ═══ 底部状态栏 ═══ -->
        <Border Grid.Row="3" Margin="0,4,0,0" Padding="8,4"
                Background="{DynamicResource PanelBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" CornerRadius="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="报警记录已加载" FontSize="11"
                           Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock Text=" | " Foreground="{DynamicResource TextDimBrush}"/>
                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}显示 {0} / {1} 条记录">
                            <Binding Path="FilteredAlarms.Count"/>
                            <Binding Path="TotalCount"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
