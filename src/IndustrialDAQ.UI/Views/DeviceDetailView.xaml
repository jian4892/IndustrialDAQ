<!-- File: DeviceDetailView.xaml  Module: UI (Views)  Author: IndustrialDAQ Team -->
<UserControl x:Class="IndustrialDAQ.UI.Views.DeviceDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource MainBgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="DataGridActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource InfoBgBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 设备信息摘要卡片 -->
        <Border Grid.Row="0" Style="{DynamicResource PanelBorderStyle}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 设备图标和名称 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🖥" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource InfoBrush}"/>
                    <StackPanel>
                        <TextBlock Text="{Binding DeviceName}" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#10B981"/>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding DeviceStatus}" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 设备参数信息 -->
                <Grid Grid.Column="1" Margin="32,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <TextBlock Text="IP 地址" FontSize="11"
                                   Foreground="{DynamicResource TextDimBrush}"/>
                        <TextBlock Text="{Binding IpAddress}" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontFamily="Consolas" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,24,0">
                        <TextBlock Text="协议" FontSize="11"
                                   Foreground="{DynamicResource TextDimBrush}"/>
                        <TextBlock Text="{Binding Protocol}" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,24,0">
                        <TextBlock Text="采集周期" FontSize="11"
                                   Foreground="{DynamicResource TextDimBrush}"/>
                        <TextBlock Text="{Binding CycleTime}" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="最后错误" FontSize="11"
                                   Foreground="{DynamicResource TextDimBrush}"/>
                        <TextBlock Text="{Binding LastError}" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 刷新按钮 -->
                <Button Grid.Column="2" Content="🔄 刷新" Width="80" Height="30"
                        Background="{DynamicResource InfoBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                        BorderThickness="0" VerticalAlignment="Center">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- 测点数据表 -->
        <Border Grid.Row="1" Style="{DynamicResource PanelBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Style="{DynamicResource PanelTitleStyle}" Text="实时测点数据"
                               Margin="0,0,0,0"/>
                    <TextBlock Text="{Binding Tags.Count, StringFormat='(共 {0} 个测点)'}"
                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Tags}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          RowStyle="{DynamicResource DataGridRowQualityStyle}"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          SelectionMode="Single" RowHeight="36" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="测点名称" Binding="{Binding TagName}"
                                            Width="160"/>
                        <DataGridTextColumn Header="测点 ID" Binding="{Binding TagId}"
                                            Width="120"/>
                        <DataGridTextColumn Header="当前值" Binding="{Binding Value}"
                                            Width="120"/>
                        <DataGridTextColumn Header="质量" Binding="{Binding Quality}"
                                            Width="90"/>
                        <DataGridTextColumn Header="时间戳" Binding="{Binding Timestamp}"
                                            Width="*"/>
                        <DataGridTemplateColumn Header="操作" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding CanWrite, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Center">
                                        <Button Content="写入" Command="{Binding DataContext.WriteTagCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" VerticalAlignment="Center"
                                                Style="{StaticResource DataGridActionButtonStyle}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
