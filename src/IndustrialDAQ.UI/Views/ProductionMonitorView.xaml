<!-- File: ProductionMonitorView.xaml  Module: UI (Views)  Author: IndustrialDAQ Team -->
<UserControl x:Class="IndustrialDAQ.UI.Views.ProductionMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:controls="clr-namespace:IndustrialDAQ.UI.Controls"
             xmlns:converters="clr-namespace:IndustrialDAQ.UI.Converters"
             xmlns:models="clr-namespace:IndustrialDAQ.UI.Models"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource BrushBgPrimary}">

    <UserControl.Resources>
        <converters:TreeArrowConverter x:Key="TreeArrowConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="DataGridActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource InfoBgBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 设备选择栏 -->
            <RowDefinition Height="Auto"/>   <!-- 报警栏 -->
            <RowDefinition Height="*"/>      <!-- 主内容区 -->
        </Grid.RowDefinitions>

        <!-- ═══════════ 设备选择栏 ═══════════ -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="4"
                Padding="10,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="选择设备:" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Devices}"
                          SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="Name"
                          IsSynchronizedWithCurrentItem="True"
                          VerticalContentAlignment="Center"
                          Height="28"/>
            </Grid>
        </Border>

        <!-- ═══════════ 报警栏 ═══════════ -->
        <Border Grid.Row="1"
                BorderThickness="1" CornerRadius="4"
                Padding="10,6" Margin="0,0,0,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}"/>
                    <Setter Property="BorderBrush" Value="#065F46"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasAlarm}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#x2705;"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAlarm}" Value="True">
                                    <Setter Property="Text" Value="&#x26A0;"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding AlarmText}"
                           FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ═══════════ 主内容区：2 列布局 ═══════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ────── 左列：仪表盘 ────── -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          Margin="0,0,6,0">
                <StackPanel>
                    <!-- 数字仪表 2x3 网格 -->
                    <Border Style="{DynamicResource PanelBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource PanelTitleStyle}"
                                       Text="实时仪表"/>
                            <ItemsControl ItemsSource="{Binding Gauges}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:SemiCircleGauge
                                            Value="{Binding Value}"
                                            MinValue="{Binding MinValue}" MaxValue="{Binding MaxValue}"
                                            Unit="{Binding Unit}" Label="{Binding Label}"
                                            GaugeColor="{Binding GaugeColor}"
                                            Height="130" Margin="3"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ────── 右列：趋势图 + 数据表 ────── -->
            <Grid Grid.Column="1" Margin="6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 实时趋势图 -->
                <Border Grid.Row="0" Style="{DynamicResource PanelBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{DynamicResource PanelTitleStyle}"
                                   Text="实时趋势图 (X=时间)"/>
                        <lvc:CartesianChart Grid.Row="1"
                                            Series="{Binding TrendSeries}"
                                            XAxes="{Binding TrendXAxes}"
                                            YAxes="{Binding TrendYAxes}"
                                            TooltipPosition="Top"
                                            TooltipTextPaint="{Binding LegendPaint}"
                                            LegendPosition="Bottom"
                                            LegendTextSize="12"
                                            LegendTextPaint="{Binding LegendPaint}"
                                            Margin="0,4"/>
                    </Grid>
                </Border>

                <!-- 实时数据表 -->
                <Border Grid.Row="2" Style="{DynamicResource PanelBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Style="{DynamicResource PanelTitleStyle}"
                                   Text="实时数据表"/>
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding TagTable}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  SelectionMode="Single"
                                  RowStyle="{DynamicResource DataGridRowQualityStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="测点名称" Binding="{Binding TagName}"
                                                    Width="180"/>
                                <DataGridTextColumn Header="当前值" Binding="{Binding Value}"
                                                    Width="120"/>
                                <DataGridTextColumn Header="质量" Binding="{Binding Quality}"
                                                    Width="80"/>
                                <DataGridTextColumn Header="时间戳" Binding="{Binding Timestamp}"
                                                    Width="120"/>
                                <!-- 动态展示列 -->
                                <DataGridTemplateColumn Header="图表展示" Width="110" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <CheckBox Content="趋势" IsChecked="{Binding IsTrendSelected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNumeric}" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <CheckBox Content="仪表" IsChecked="{Binding IsGaugeSelected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNumeric}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- 数据写入列 -->
                                <DataGridTemplateColumn Header="操作" Width="100" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding CanWrite, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Center">
                                                <Button Content="写入" Command="{Binding DataContext.WriteTagCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                        CommandParameter="{Binding}" VerticalAlignment="Center"
                                                        Style="{DynamicResource DataGridActionButtonStyle}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
