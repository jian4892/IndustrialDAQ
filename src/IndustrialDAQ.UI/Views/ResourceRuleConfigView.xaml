<UserControl x:Class="IndustrialDAQ.UI.Views.ResourceRuleConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:models="clr-namespace:IndustrialDAQ.Core.Models;assembly=IndustrialDAQ.Core"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource MainBgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        
        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource BrushBgTertiary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：规则列表 -->
        <Border Grid.Column="0" Background="{DynamicResource PanelBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="规则配置列表" Style="{StaticResource HeaderTextStyle}" Margin="0"/>
                    
                    <Button Grid.Column="1" Content="➕ 新增规则" Command="{Binding CreateNewCommand}" 
                            Background="Transparent" BorderBrush="{DynamicResource SuccessBrush}" Foreground="{DynamicResource SuccessBrush}" 
                            Padding="12,6" Margin="0,0,10,0" Cursor="Hand" BorderThickness="1"
                            ToolTip="创建一条新的报警规则"/>
                            
                    <Button Grid.Column="2" Content="🔄 应用并热重载" Command="{Binding ReloadEngineCommand}" 
                            Background="{DynamicResource WarningBrush}" Foreground="White" 
                            Padding="12,6" Cursor="Hand" BorderThickness="0"
                            ToolTip="将更改应用到底层规则引擎并生效"/>
                </Grid>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" 
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          Background="Transparent" BorderThickness="0" RowBackground="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="规则 ID" Binding="{Binding RuleId}" Width="100"/>
                        <DataGridTextColumn Header="报警代码" Binding="{Binding AlarmCode}" Width="120"/>
                        <DataGridTextColumn Header="资源路径" Binding="{Binding ResourcePath}" Width="160"/>
                        <DataGridTextColumn Header="报警级别" Binding="{Binding Severity}" Width="80"/>
                        <DataGridTextColumn Header="条件表达式" Binding="{Binding ConditionExpression}" Width="*"/>
                        <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnabled}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 右侧：表单编辑区 -->
        <Border Grid.Column="2" Background="{DynamicResource PanelBgBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20">
            <Grid IsEnabled="{Binding HasSelectedRule}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="规则详情编辑" Style="{StaticResource HeaderTextStyle}"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="规则 ID (RuleId)" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding EditModel.RuleId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}" IsReadOnly="{Binding IsEditMode}"/>

                        <TextBlock Text="报警代码 (AlarmCode)" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding EditModel.AlarmCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>

                        <TextBlock Text="关联资源路径 (ResourcePath)" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding EditModel.ResourcePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"
                                 ToolTip="例如: Factory/LineA/PLC1/Temp1/Alarm/TEMP_HIGH"/>

                        <TextBlock Text="触发条件 (ConditionExpression)" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding EditModel.ConditionExpression, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"
                                 ToolTip="例如: Value &gt; 80"/>

                        <TextBlock Text="报警级别 (Severity)" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox SelectedItem="{Binding EditModel.Severity}" ItemsSource="{Binding Severities}" Height="36" Margin="0,0,0,16"/>

                        <TextBlock Text="消息模板 (MessageTemplate)" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding EditModel.MessageTemplate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"
                                 ToolTip="支持占位符: {Value}, {TagName}"/>

                        <CheckBox Content="是否启用" IsChecked="{Binding EditModel.IsEnabled}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- 保存按钮 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="删除" Command="{Binding DeleteCommand}" Background="{DynamicResource DangerBrush}" Foreground="White" Padding="16,8" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand" Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Content="保存" Command="{Binding SaveCommand}" Background="{DynamicResource InfoBrush}" Foreground="White" Padding="24,8" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
