<UserControl x:Class="IndustrialDAQ.UI.Views.WriteTagDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Width="380" Height="220"
             Background="Transparent"
             Foreground="{DynamicResource TextPrimaryBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="{DynamicResource BrushBgSecondary}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
    </UserControl.Resources>

    <!-- 增加阴影和圆角边框 -->
    <Border Background="{DynamicResource CardBgBrush}" 
            BorderBrush="{DynamicResource BorderSecondaryBrush}" 
            BorderThickness="1" CornerRadius="8" Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.4" Direction="270" ShadowDepth="4"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <TextBlock Text="{Binding TagName, StringFormat='正在写入测点: {0}'}" FontSize="14" FontWeight="Bold" Margin="0,0,0,16"/>
            
            <TextBlock Grid.Row="1" Text="请输入或选择要写入的值：" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
            
            <!-- 数值输入框 -->
            <TextBox x:Name="ValueTextBox" Grid.Row="2" VerticalAlignment="Top" Padding="6"
                     Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding IsNumericInput, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="14"/>
                     
            <!-- 布尔选择框 -->
            <ComboBox x:Name="ValueComboBox" Grid.Row="2" VerticalAlignment="Top" Padding="6"
                      ItemsSource="{Binding BooleanOptions}"
                      SelectedItem="{Binding SelectedBooleanOption}"
                      Visibility="{Binding IsBooleanInput, Converter={StaticResource BooleanToVisibilityConverter}}" FontSize="14">
            </ComboBox>


            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" Command="{Binding CancelCommand}"/>
                <Button Content="确定" Command="{Binding ConfirmCommand}" Background="{DynamicResource InfoBgBrush}" Foreground="{DynamicResource InfoBrush}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
